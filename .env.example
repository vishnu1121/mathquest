# Copy to .env.local for local development. Never commit real keys.

# Server-side only. Create a key at https://console.anthropic.com and set a monthly spend limit there.
ANTHROPIC_API_KEY=

# Set to "false" to switch every AI feature off. The game keeps working with its built-in text.
AI_ENABLED=true

# ---------------------------------------------------------------------------
# "You wanna know how?" — the step-by-step explainer.
#
# This runs on its OWN provider account, deliberately. It is the one AI feature a
# curious child can ask for over and over, and sharing a key would let it drain the
# allowance that hints, coaching and Story Lab depend on. There is no fallback to
# the keys above: if these are unset the feature is simply off and the game hides
# the button rather than showing a control that cannot answer.
EXPLAIN_AI_PROVIDER=groq
EXPLAIN_AI_API_KEY=
EXPLAIN_AI_MODEL=openai/gpt-oss-120b
# Set to "false" to switch just the explainer off, leaving the rest of the AI on.
EXPLAIN_AI_ENABLED=true

# ---------------------------------------------------------------------------
# Fresh AI-written questions.
#
# These two accounts write new questions during play so that replaying a quest is not
# replaying the same five questions. They are tried in order — GEN first, GEN2 only if
# GEN fails, times out, or returns something the server cannot re-solve — and if both
# come up short the built-in question bank answers, which it is always ready to do.
#
# Generation is the highest-volume AI call in the game (one per question), so it gets
# its own accounts for the same reason the explainer does: it must not be able to drain
# the key that hints, coaching and Story Lab share. There is no fallback to those keys.
# With both unset, every question comes from the built-in bank and nothing else changes.
#
# Apex Mode (Grades 3-5) uses the same two accounts and the same fallback.
GEN_AI_PROVIDER=groq
GEN_AI_API_KEY=
GEN_AI_MODEL=openai/gpt-oss-120b
# Set to "false" to switch fresh questions off, leaving the rest of the AI on.
GEN_AI_ENABLED=true

# The second account. A different provider is fine, and is the point: if one is down or
# out of free credit, the other answers.
GEN2_AI_PROVIDER=groq
GEN2_AI_API_KEY=
GEN2_AI_MODEL=openai/gpt-oss-120b
GEN2_AI_ENABLED=true

# ---------------------------------------------------------------------------
# Understudies.
#
# Every job above has a second account, tried only when the first fails, is out of
# credit, times out, or answers with something the guard refuses. A free-tier key
# does not fail politely — it runs out mid-lesson — so the second account is what
# keeps a feature alive until somebody notices. All of these are optional: with an
# understudy unset, that job simply has one account, exactly as before.

# Hoot's hints, on their own accounts. The helper a stuck child reaches for most.
# With HINT_AI_* unset, hints share the general AI_* keys as they always did.
HINT_AI_PROVIDER=groq
HINT_AI_API_KEY=
HINT_AI_MODEL=openai/gpt-oss-120b
HINT_AI_ENABLED=true
HINT2_AI_PROVIDER=groq
HINT2_AI_API_KEY=
HINT2_AI_MODEL=openai/gpt-oss-120b
HINT2_AI_ENABLED=true

# Understudy for the general account (coaching, Story Lab, narration, diagnosis).
AI2_PROVIDER=groq
AI2_API_KEY=
AI2_MODEL=openai/gpt-oss-120b
AI2_ENABLED=true

# Understudy for "You wanna know how?".
EXPLAIN2_AI_PROVIDER=groq
EXPLAIN2_AI_API_KEY=
EXPLAIN2_AI_MODEL=openai/gpt-oss-120b
EXPLAIN2_AI_ENABLED=true
